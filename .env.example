# Copy this file to .env.local and fill in your values.
# Get these from your Supabase project: Dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# The public URL of your app (used for password-reset redirect links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Without it, thesis uploads skip the Semantic Scholar paper-ID
# lookup and detail pages show no related papers — everything else works.
# Request a key at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
