# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Security: environment & secrets ──────────────────────────
# NEVER commit .env files — they contain Supabase keys and secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
# Allow the safe template (contains only placeholder values, no real secrets)
!.env.example

# ── Supabase local ──────────────────────────────────────────
/supabase/.temp/
/supabase/.branches/

# ── Vercel ──────────────────────────────────────────────────
.vercel

# ── TypeScript ──────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── IDE / Editor ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS files ────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.Spotlight-V100
.Trashes

# ── Project-specific: dev-only, not for public repo ─────────
# Local editor/tooling instruction files
.agents/
# Legacy Django reference code (kept locally for dev reference)
_legacy_reference/

